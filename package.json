{
  "name": "skill-diet",
  "version": "0.1.0",
  "description": "Agent skills that keep other skills lean, correct, and working on every model you run.",
  "keywords": [
    "pi-package",
    "agent-skills",
    "skills",
    "claude-code-plugin"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "homepage": "https://github.com/nicobailon/skill-diet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/skill-diet.git"
  },
  "files": [
    "skills",
    ".claude-plugin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node skills/skill-diet/scripts/eval.mjs check . && node tools/version.mjs --check",
    "preversion": "npm run check",
    "prepublishOnly": "npm run check",
    "version": "node tools/version.mjs && git add .claude-plugin/plugin.json CHANGELOG.md skills/*/SKILL.md"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "image": "./.claude-plugin/icon.png"
  }
}
